type GlobalAttributes = {
  accesskey?: string,
  autocapitalize?: string,
  autofocus?: boolean,
  class?: string,
  contenteditable?: boolean,
  dir?: string,
  draggable?: boolean,
  enterkeyhint?: string,
  exportparts?: string,
  hidden?: boolean,
  id?: string,
  inert?: boolean,
  inputmode?: string,
  is?: string,
  itemid?: string,
  itemprop?: string,
  itemref?: string,
  itemscope?: boolean,
  itemtype?: string,
  lang?: string,
  nonce?: string,
  part?: string,
  popover?: boolean,
  role?: string,
  slot?: string,
  spellcheck?: boolean,
  style?: style,
  tabindex?: integer,
  title?: string,
  translate?: boolean,
};

view address GlobalAttributes;
